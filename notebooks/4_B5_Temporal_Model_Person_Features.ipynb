   "source": [
    "# Model 4: Baseline 5 (B5) — Temporal Model with Person Features\n",
    "**Reference:** Ibrahim et al., *A Hierarchical Deep Temporal Model for Group Activity Recognition*, CVPR 2016 (Section 4.1 #5)\n",
    "\n",
    "### Architecture & Workflow\n",
    "\"This baseline is a temporal extension of the second baseline: fc7 features pooled over all people are fed to a LSTM model to recognize group activities.\"\n",
    "\n",
    "1. **Input:** 9 frames $\\times$ 12 player bounding-box crops per clip $\\rightarrow (B, 9, 12, 3, 224, 224)$.\n",
    "2. **Feature Extraction:** Off-the-shelf ImageNet ResNet-50 extracts 2048-dim features for all 12 players across 9 timesteps $\\rightarrow (B, 9, 12, 2048)$.\n",
    "3. **Player Pooling:** Max-pooling over all 12 players at each timestep $t$:\n",
    "   $$Z_t = \\max_{k=1..12} x_{tk} \\in \\mathbb{R}^{2048}$$\n",
    "   Produces a sequence of 9 frame-level scene vectors $(B, 9, 2048)$.\n",
    "4. **Temporal Modeling:** An LSTM layer (9 timesteps, 500 hidden units) models scene dynamics over time.\n",
    "5. **Classification:** A linear head ($500 \\rightarrow 8$) classifies the final hidden state into 8 group activities."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import json\n",
    "import random\n",
    "import warnings\n",
    "from PIL import Image\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "import torchvision.transforms as transforms\n",
    "from torchvision import models\n",
    "from sklearn.metrics import accuracy_score, f1_score, precision_score, recall_score, confusion_matrix, classification_report\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Paths & Hardware Setup\n",
    "DATASET_ROOT = \"/kaggle/input/datasets/ahmedmohamed365/volleyball\"\n",
    "VIDEOS_ROOT = \"/kaggle/input/datasets/ahmedmohamed365/volleyball/volleyball_/videos\"\n",
    "TRACKING_ROOT = \"/kaggle/input/datasets/ahmedmohamed365/volleyball/volleyball_tracking_annotation/volleyball_tracking_annotation\"\n",
    "\n",
    "# Output directories\n",
    "RESULTS_DIR = \"results/4_B5_Temporal_Model_Person_Features\"\n",
    "PLOTS_DIR = os.path.join(RESULTS_DIR, \"plots\")\n",
    "METRICS_DIR = os.path.join(RESULTS_DIR, \"metrics\")\n",
    "os.makedirs(PLOTS_DIR, exist_ok=True)\n",
    "os.makedirs(METRICS_DIR, exist_ok=True)\n",
    "\n",
    "SEED = 42\n",
    "random.seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)\n",
    "torch.cuda.manual_seed_all(SEED)\n",
    "torch.backends.cudnn.benchmark = True\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(f\"Device: {device}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Official 55-Video Splits & Label Map\n",
    "TRAIN_VIDEOS = {1, 3, 6, 7, 10, 13, 15, 16, 18, 22, 23, 31, 32, 36, 38, 39, 40, 41, 42, 48, 50, 52, 53, 54}\n",
    "VAL_VIDEOS   = {0, 2, 8, 12, 17, 19, 24, 26, 27, 28, 30, 33, 46, 49, 51}\n",
    "TEST_VIDEOS  = {4, 5, 9, 11, 14, 20, 21, 25, 29, 34, 35, 37, 43, 44, 45, 47}\n",
    "\n",
    "CLASSES = ['l_pass', 'r_pass', 'l_spike', 'r_spike', 'l_set', 'r_set', 'l_winpoint', 'r_winpoint']\n",
    "LABEL_MAP = {\n",
    "    \"l_pass\": 0, \"r_pass\": 1, \"l_spike\": 2, \"r_spike\": 3,\n",
    "    \"l_set\": 4, \"r_set\": 5, \"l_winpoint\": 6, \"r_winpoint\": 7,\n",
    "    \"l-pass\": 0, \"r-pass\": 1, \"l-spike\": 2, \"r-spike\": 3,\n",
    "    \"l-set\": 4, \"r-set\": 5, \"l-winpoint\": 6, \"r-winpoint\": 7\n",
    "}\n",
    "\n",
    "IMAGE_SIZE = (224, 224)\n",
    "BATCH_SIZE = 16\n",
    "LR = 1e-3\n",
    "EPOCHS = 40"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Tracking Annotation Parser\n",
    "class BoxInfo:\n",
    "    def __init__(self, line):\n",
    "        words = line.split()\n",
    "        self.category = words.pop()\n",
    "        words = [int(w) for w in words]\n",
    "        self.player_ID = words[0]\n",
    "        x1, y1, x2, y2, frame_ID, lost, grouping, generated = words[1:]\n",
    "        self.box = (x1, y1, x2, y2)\n",
    "        self.frame_ID = frame_ID\n",
    "\n",
    "def load_tracking_annot(path):\n",
    "    player_boxes = {idx: [] for idx in range(12)}\n",
    "    frame_boxes_dct = {}\n",
    "    if not os.path.isfile(path):\n",
    "        return frame_boxes_dct\n",
    "    with open(path, 'r') as file:\n",
    "        for line in file:\n",
    "            b = BoxInfo(line)\n",
    "            if b.player_ID > 11:\n",
    "                continue\n",
    "            player_boxes[b.player_ID].append(b)\n",
    "    for player_ID, boxes_info in player_boxes.items():\n",
    "        boxes_info = boxes_info[5:-6] if len(boxes_info) > 11 else boxes_info\n",
    "        for b in boxes_info:\n",
    "            if b.frame_ID not in frame_boxes_dct:\n",
    "                frame_boxes_dct[b.frame_ID] = []\n",
    "            frame_boxes_dct[b.frame_ID].append(b)\n",
    "    return frame_boxes_dct"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load 9-Frame Sequence Annotations (All 55 Videos)\n",
    "def get_sequence_frame_paths(middle_frame_path, num_frames_around=4):\n",
    "    clip_dir = os.path.dirname(middle_frame_path)\n",
    "    base_name = os.path.basename(middle_frame_path)\n",
    "    name, ext = os.path.splitext(base_name)\n",
    "    mid_id = int(name)\n",
    "    paths = []\n",
    "    for offset in range(-num_frames_around, num_frames_around + 1):\n",
    "        p = os.path.join(clip_dir, f\"{mid_id + offset}{ext}\")\n",
    "        paths.append(p if os.path.isfile(p) else middle_frame_path)\n",
    "    return paths\n",
    "\n",
    "data = []\n",
    "for vid_name in sorted(os.listdir(VIDEOS_ROOT)):\n",
    "    vpath = os.path.join(VIDEOS_ROOT, vid_name)\n",
    "    if not os.path.isdir(vpath):\n",
    "        continue\n",
    "    ann_path = os.path.join(vpath, \"annotations.txt\")\n",
    "    if not os.path.isfile(ann_path):\n",
    "        continue\n",
    "    vid_id = int(vid_name)\n",
    "    with open(ann_path, 'r') as f:\n",
    "        for line in f:\n",
    "            parts = line.strip().split()\n",
    "            if len(parts) >= 2:\n",
    "                img_name, grp_lbl = parts[0], parts[1]\n",
    "                clip_id = os.path.splitext(img_name)[0]\n",
    "                mid_img_path = os.path.join(vpath, clip_id, img_name)\n",
    "                trk_path = os.path.join(TRACKING_ROOT, str(vid_id), clip_id, f\"{clip_id}.txt\")\n",
    "                seq_paths = get_sequence_frame_paths(mid_img_path, num_frames_around=4)\n",
    "                data.append({\"video_id\": vid_id, \"clip_id\": clip_id, \"frame_paths\": seq_paths, \"tracking_path\": trk_path, \"group_label\": grp_lbl})\n",
    "\n",
    "train_data = [d for d in data if d[\"video_id\"] in TRAIN_VIDEOS]\n",
    "val_data   = [d for d in data if d[\"video_id\"] in VAL_VIDEOS]\n",
    "test_data  = [d for d in data if d[\"video_id\"] in TEST_VIDEOS]\n",
    "print(f\"Total clips: {len(data)} | Train: {len(train_data)} | Val: {len(val_data)} | Test: {len(test_data)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Model Definition: B5Model (Temporal Model with Person Features)\n",
    "class B5Model(nn.Module):\n",
    "    def __init__(self, num_classes=8, hidden_dim=500, dropout=0.5):\n",
    "        super().__init__()\n",
    "        resnet = models.resnet50(weights=models.ResNet50_Weights.DEFAULT)\n",
    "        self.backbone = nn.Sequential(*list(resnet.children())[:-1])\n",
    "        for p in self.backbone.parameters():\n",
    "            p.requires_grad = False  # Off-the-shelf ImageNet CNN features frozen\n",
    "        self.lstm = nn.LSTM(input_size=2048, hidden_size=hidden_dim, num_layers=1, batch_first=True)\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "        self.classifier = nn.Linear(hidden_dim, num_classes)\n",
    "\n",
    "    def forward(self, x):\n",
    "        # x: (B, 9, 12, 3, 224, 224)\n",
    "        B, T, K, C, H, W = x.shape\n",
    "        x_flat = x.view(B * T * K, C, H, W)\n",
    "        with torch.no_grad():\n",
    "            feats = self.backbone(x_flat).view(B, T, K, 2048)\n",
    "        # Max-pool across 12 players per frame: Z_t = max_k (x_tk) [Eq. 8]\n",
    "        scene_seq = feats.max(dim=2)[0]  # (B, 9, 2048)\n",
    "        _, (hn, _) = self.lstm(scene_seq)\n",
    "        return self.classifier(self.dropout(hn[-1]))\n",
    "\n",
    "b5_model = B5Model().to(device)\n",
    "print(b5_model)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Dataset & DataLoaders\n",
    "crop_transform = transforms.Compose([\n",
    "    transforms.Resize(IMAGE_SIZE),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "\])\n",
    "\n",
    "# Train-only augmentation for person crops.\n",
    "# NO horizontal flip - flipping swaps left/right court sides and would corrupt l_/r_ labels.\n",
    "crop_train_transform = transforms.Compose([\n    transforms.Resize(IMAGE_SIZE),\n    transforms.RandomAffine(degrees=10, translate=(0.05, 0.05)),\n    transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2),\n    transforms.ToTensor(),\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n])\n",
    "\n",
    "class VolleyballPersonSeqDataset(Dataset):\n",
    "    def __init__(self, data, transform=None):\n",
    "        self.data = data\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.data)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        d = self.data[idx]\n",
    "        fboxes = load_tracking_annot(d[\"tracking_path\"])\n",
    "        all_frames = []\n",
    "        for p in d[\"frame_paths\"]:\n",
    "            img = Image.open(p).convert(\"RGB\")\n",
    "            fid_str = os.path.splitext(os.path.basename(p))[0]\n",
    "            try: fid = int(fid_str)\n",
    "            except: fid = list(fboxes.keys())[0] if fboxes else 0\n",
    "            boxes = fboxes.get(fid, [])\n",
    "            crops = []\n",
    "            w, h = img.size\n",
    "            for b in boxes[:12]:\n",
    "                x1, y1, x2, y2 = b.box\n",
    "                c = img.crop((max(0, x1), max(0, y1), min(w, max(x1+1, x2)), min(h, max(y1+1, y2))))\n",
    "                if self.transform: c = self.transform(c)\n",
    "                crops.append(c)\n",
    "            while len(crops) < 12:\n",
    "                crops.append(torch.zeros(3, *IMAGE_SIZE))\n",
    "            all_frames.append(torch.stack(crops))\n",
    "        clip = torch.stack(all_frames)  # (9, 12, 3, 224, 224)\n",
    "        label = torch.tensor(LABEL_MAP[d[\"group_label\"]], dtype=torch.long)\n",
    "        return clip, label\n",
    "\n",
    "b5_train_ds = VolleyballPersonSeqDataset(train_data, transform=crop_transform)\n",
    "b5_val_ds   = VolleyballPersonSeqDataset(val_data, transform=crop_transform)\n",
    "b5_test_ds  = VolleyballPersonSeqDataset(test_data, transform=crop_transform)\n",
    "\n",
    "loader_kw = dict(num_workers=2, pin_memory=(device == \"cuda\"), persistent_workers=True)\n",
    "train_loader = DataLoader(b5_train_ds, batch_size=BATCH_SIZE, shuffle=True, drop_last=True, **loader_kw)\n",
    "val_loader   = DataLoader(b5_val_ds, batch_size=BATCH_SIZE, shuffle=False, **loader_kw)\n",
    "test_loader  = DataLoader(b5_test_ds, batch_size=BATCH_SIZE, shuffle=False, **loader_kw)\n",
    "print(f\"Batches -> Train: {len(train_loader)} | Val: {len(val_loader)} | Test: {len(test_loader)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Training Loop\n",
    "optimizer = optim.AdamW(list(b5_model.lstm.parameters()) + list(b5_model.classifier.parameters()), lr=LR, weight_decay=1e-4)\n",
    "criterion = nn.CrossEntropyLoss()\n",
    "scaler = torch.cuda.amp.GradScaler(enabled=(device == \"cuda\"))\n",
    "scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS, eta_min=1e-6)\n",
    "\n",
    "history = {'train_loss': [], 'val_loss': [], 'train_acc': [], 'val_acc': []}\n",
    "best_val_acc = 0.0\n",
    "early_stop_counter = 0\n",
    "\n",
    "for epoch in range(EPOCHS):\n",
    "    b5_model.train()\n",
    "    tr_loss, tr_corr, tr_tot = 0.0, 0, 0\n",
    "    for x, y in tqdm(train_loader, desc=f\"Epoch {epoch+1:02d}/{EPOCHS} [Train]\", leave=False):\n",
    "        x, y = x.to(device, non_blocking=True), y.to(device, non_blocking=True)\n",
    "        optimizer.zero_grad()\n",
    "        with torch.cuda.amp.autocast(enabled=(device == \"cuda\")):\n",
    "            out = b5_model(x)\n",
    "            loss = criterion(out, y)\n",
    "        scaler.scale(loss).backward()\n",
    "        scaler.step(optimizer)\n",
    "        scaler.update()\n",
    "        tr_loss += loss.item() * x.size(0)\n",
    "        tr_corr += (out.argmax(1) == y).sum().item()\n",
    "        tr_tot += y.size(0)\n",
    "    \n",
    "    b5_model.eval()\n",
    "    val_loss, val_corr, val_tot = 0.0, 0, 0\n",
    "    with torch.no_grad():\n",
    "        for x, y in tqdm(val_loader, desc=f\"Epoch {epoch+1:02d} [Val]\", leave=False):\n",
    "            x, y = x.to(device, non_blocking=True), y.to(device, non_blocking=True)\n",
    "            with torch.cuda.amp.autocast(enabled=(device == \"cuda\")):\n",
    "                out = b5_model(x)\n",
    "                loss = criterion(out, y)\n",
    "            val_loss += loss.item() * x.size(0)\n",
    "            val_corr += (out.argmax(1) == y).sum().item()\n",
    "            val_tot += y.size(0)\n",
    "            \n",
    "    scheduler.step()\n",
    "    ep_tr_loss, ep_tr_acc = tr_loss / tr_tot, tr_corr / tr_tot * 100\n",
    "    ep_val_loss, ep_val_acc = val_loss / val_tot, val_corr / val_tot * 100\n",
    "    history['train_loss'].append(ep_tr_loss)\n",
    "    history['val_loss'].append(ep_val_loss)\n",
    "    history['train_acc'].append(ep_tr_acc)\n",
    "    history['val_acc'].append(ep_val_acc)\n",
    "    \n",
    "    print(f\"Ep {epoch+1:02d}/{EPOCHS} | Train Loss: {ep_tr_loss:.4f} Acc: {ep_tr_acc:.2f}% | Val Loss: {ep_val_loss:.4f} Acc: {ep_val_acc:.2f}%\")\n",
    "    if ep_val_acc > best_val_acc + EARLY_STOP_MIN_DELTA:\n",
    "        best_val_acc = ep_val_acc\n",
    "        early_stop_counter = 0\n",
    "        torch.save(b5_model.state_dict(), os.path.join(RESULTS_DIR, \"best_model.pth\"))\n",
    "        print(f\"  --> Saved best B5 checkpoint (Val Acc: {best_val_acc:.2f}%)\")\n",
    "    else:\n",
    "        early_stop_counter += 1\n",
    "        print(f\"  [--] No improvement [{early_stop_counter}/{EARLY_STOP_PATIENCE}]\")\n",
    "        if early_stop_counter >= EARLY_STOP_PATIENCE:\n",
    "            print(f\"[Early Stopping] No improvement for {EARLY_STOP_PATIENCE} consecutive epochs.\")\n",
    "            break"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluation, Metrics Generation & Export\n",
    "best_path = os.path.join(RESULTS_DIR, \"best_model.pth\")\n",
    "if os.path.isfile(best_path):\n",
    "    b5_model.load_state_dict(torch.load(best_path, map_location=device))\n",
    "    print(f\"Loaded best model from {best_path}\")\n",
    "\n",
    "b5_model.eval()\n",
    "test_preds, test_targets = [], []\n",
    "with torch.no_grad():\n",
    "    for x, y in tqdm(test_loader, desc=\"[Test Evaluation]\"):\n",
    "        x = x.to(device, non_blocking=True)\n",
    "        with torch.cuda.amp.autocast(enabled=(device == \"cuda\")):\n",
    "            out = b5_model(x)\n",
    "        test_preds.extend(out.argmax(1).cpu().numpy())\n",
    "        test_targets.extend(y.numpy())\n",
    "\n",
    "test_acc = accuracy_score(test_targets, test_preds)\n",
    "test_f1_weighted = f1_score(test_targets, test_preds, average='weighted', zero_division=0)\n",
    "test_f1_macro = f1_score(test_targets, test_preds, average='macro', zero_division=0)\n",
    "test_prec = precision_score(test_targets, test_preds, average='weighted', zero_division=0)\n",
    "test_rec = recall_score(test_targets, test_preds, average='weighted', zero_division=0)\n",
    "\n",
    "metrics_dict = {\n",
    "    \"model\": \"B5 - Temporal Model with Person Features\",\n",
    "    \"test_accuracy\": float(test_acc),\n",
    "    \"test_f1_weighted\": float(test_f1_weighted),\n",
    "    \"test_f1_macro\": float(test_f1_macro),\n",
    "    \"test_precision\": float(test_prec),\n",
    "    \"test_recall\": float(test_rec),\n",
    "    \"best_val_accuracy\": float(best_val_acc)\n",
    "}\n",
    "\n",
    "with open(os.path.join(METRICS_DIR, \"metrics.json\"), 'w') as f:\n",
    "    json.dump(metrics_dict, f, indent=4)\n",
    "\n",
    "pd.DataFrame(history).to_csv(os.path.join(METRICS_DIR, \"training_history.csv\"), index=False)\n",
    "\n",
    "rep_dict = classification_report(test_targets, test_preds, target_names=CLASSES, output_dict=True, zero_division=0)\n",
    "pd.DataFrame(rep_dict).transpose().to_csv(os.path.join(METRICS_DIR, \"classification_report.csv\"))\n",
    "\n",
    "print(f\"\\nTest Accuracy: {test_acc * 100:.2f}%\")\n",
    "print(f\"Test Weighted F1: {test_f1_weighted:.4f}\")\n",
    "print(classification_report(test_targets, test_preds, target_names=CLASSES, zero_division=0))"
   ]
  },
