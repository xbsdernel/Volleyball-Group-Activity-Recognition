    "fig, axs = plt.subplots(1, 2, figsize=(14, 5))\n",
    "axs[0].plot(history['train_loss'], label='Train Loss', color='royalblue')\n",
    "axs[0].plot(history['val_loss'], label='Val Loss', color='crimson')\n",
    "axs[0].set_title('Loss Curves (B5)')\n",
